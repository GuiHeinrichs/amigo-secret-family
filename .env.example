# Postgres de produção (ex.: Neon pelo Vercel Marketplace).
# Sem esta variável o app usa um Postgres embutido (PGlite) em .data/ — ideal para o dev local.
DATABASE_URL=

# Segredo que assina o cookie de sessão. Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Envio dos códigos de login (https://resend.com). Obrigatório em produção.
# Sem a chave, o dev local mostra o código na própria tela de login.
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: Laço <entrar@seudominio.com.br>
EMAIL_FROM=

# Endereço público do site, usado nos links de preview. Opcional na Vercel.
NEXT_PUBLIC_SITE_URL=
